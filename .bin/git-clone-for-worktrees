#!/bin/zsh
set -e

# Examples of call:
# git-clone-for-worktrees git@github.com:name/repo.git
# => Clones to a /repo directory, creates main worktree
#
# git-clone-for-worktrees git@github.com:name/repo.git my-repo
# => Clones to a /my-repo directory, creates main worktree
#
# git-clone-for-worktrees --default-branch develop git@github.com:name/repo.git
# => Clones to a /repo directory, creates develop worktree

default_branch=main
positional=()

while (( $# )); do
  case $1 in
    --default-branch)
      default_branch=$2
      shift 2
      ;;
    --default-branch=*)
      default_branch=${1#*=}
      shift
      ;;
    *)
      positional+=($1)
      shift
      ;;
  esac
done

url=$positional[1]
basename=${url##*/}
name=${positional[2]:-${basename%.*}}

mkdir $name
cd "$name"

git clone --bare "$url" .bare
echo "gitdir: ./.bare" > .git

git config remote.origin.fetch "+refs/heads/*:refs/remotes/origin/*"

git fetch origin

echo
echo "Creating $default_branch worktree"
echo

git worktree add "$default_branch" "$default_branch"

cd "$default_branch"

git branch --set-upstream-to=origin/"$default_branch" "$default_branch"
